<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Pidief.Client</RootNamespace>

    <PackageId>Pidief.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>Milvasoft</Authors>
    <Company>Milvasoft</Company>
    <Product>pidief</Product>
    <Description>Typed .NET client for the pidief PDF API: HTML/template/images to PDF, merge, split, pages, watermark, stamp, compress, PDF/A-2b, encryption, metadata, render and text.</Description>
    <Copyright>Copyright 2026 Milvasoft</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Milvasoft/pidief</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Milvasoft/pidief.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;html-to-pdf;pdfa;pidief;milvasoft</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../../../assets/logo/pidief-icon-256.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pidief.Client.Tests" />
  </ItemGroup>

</Project>
